            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "telemetry_volume",
                  "fields": [
                    {
                      "name": "satellite_id",
                      "expression": "`satellite_id`"
                    },
                    {
                      "name": "ground_station_id",
                      "expression": "`ground_station_id`"
                    },
                    {
                      "name": "sum(record_count)",
                      "expression": "SUM(`record_count`)"
                    }
                  ],
                  "cubeGroupingSets": {
                    "sets": [
                      {
                        "fieldNames": [
                          "satellite_id"
                        ]
                      },
                      {
                        "fieldNames": [
                          "ground_station_id"
                        ]
                      }
                    ]
                  },
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "`satellite_id`"
                    },
                    {
                      "direction": "ASC",
                      "expression": "`ground_station_id`"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Telemetry Volume: Satellite x Ground Station"
              },
              "version": 3,
              "widgetType": "pivot",
