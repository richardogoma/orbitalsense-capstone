                "rows": [
                  {
                    "fieldName": "satellite_id"
                  }
                ],
                "columns": [
                  {
                    "fieldName": "ground_station_id"
                  }
                ],
                "cell": {
                  "type": "single-cell",
                  "fieldName": "sum(record_count)",
                  "cellType": "text"
                }
              },
              "data": {
                "queryName": "main_query"
              }
